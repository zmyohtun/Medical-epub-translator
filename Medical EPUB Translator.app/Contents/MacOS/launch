#!/bin/zsh
APP_DIR="/Users/m4/.gemini/antigravity/scratch/medical-epub-translator"
cd "$APP_DIR" || exit 1

# Start uvicorn in background if port 8000 is not already listening
if ! lsof -i :8000 -sTCP:LISTEN >/dev/null 2>&1; then
    nohup "$APP_DIR/.venv/bin/uvicorn" backend.main:app --port 8000 > /tmp/medical_epub_translator.log 2>&1 &
    sleep 2
fi

# Open in standalone app window (Chrome app mode if available, else default browser)
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="http://127.0.0.1:8000"
else
    open "http://127.0.0.1:8000"
fi
